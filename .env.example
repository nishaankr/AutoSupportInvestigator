# Provider keys: only the providers named in the model strings below are required.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=autosupport

# Model strings are provider:model, provider in {anthropic, groq} (decisions.md D20), e.g.
#   groq:openai/gpt-oss-20b   (Groq's free tier caps this at 8K tokens/min: too small for
#                              an investigate call; needs Groq's Dev tier)
AUTOSUPPORT_MAIN_MODEL=groq:openai/gpt-oss-120b
AUTOSUPPORT_FAST_MODEL=groq:openai/gpt-oss-20b
# Offline-eval judge only; kept separate so changing a tier never changes who grades it.
AUTOSUPPORT_JUDGE_MODEL=groq:openai/gpt-oss-120b
AUTOSUPPORT_EMBED_MODEL=BAAI/bge-small-en-v1.5
AUTOSUPPORT_DATA_DIR=./data
